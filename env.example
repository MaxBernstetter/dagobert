# Copy to .env in the repo root (optional). Docker Compose also uses defaults in compose.yaml.
# Published host ports. Container ports stay 4566, 5432, 8090, and 3000.
# FLOCI_PORT=4566
# POSTGRES_PORT=5432
# ORCHESTRATOR_PORT=8090
# WEB_PORT=3001
HOST_DATA_DIR=./data
HOST_PLAYBOOKS_DIR=./src/calculation-signal/playbooks
HOST_SECRETS_FILE=./.secrets
# Parallel experiment (experiment) instance simulations in the backtest job (default 4).
# EXPERIMENT_SIM_WORKERS=4
# Experiment compute engine per run: go (default) or cpp (ma-cross and signal-consensus; fails other playbooks).
# EXPERIMENT_ENGINE=go
# cpp engine: concurrent C++ processes (default CPU count) and max instances per process (default 500).
# EXPERIMENT_CPP_PROCESSES=
# EXPERIMENT_CPP_SHARD_MAX=500
# CPP_SMA_CROSS_BIN=/usr/local/bin/strategy-sma-cross   # required for ma-cross with EXPERIMENT_ENGINE=cpp; set to this path in the dagobert-backtest image
# CPP_SIGNAL_CONSENSUS_BIN=/usr/local/bin/strategy-signal-consensus   # same for signal-consensus
# Ingest market-data provider id (default binance). One provider per ingest run.
# INGEST_PROVIDER=binance

# --- Floci / serverless migration (steps 1–5) ---
# After: task infra:local  (terraform apply against Floci + optional SSM seed)
# DEPLOY_ENV=local
# SSM_PREFIX=/dagobert/local
# LAKE_BUCKET=dagobert-local-lake
# SECRETS_BACKEND=auto
# EXPERIMENT_ARTIFACTS=fs
# Set EXPERIMENT_ARTIFACTS=s3 to dual-write/read instance report.json via Floci S3.
#
# Step 4 / 14 — experiment catalog is Postgres when DATABASE_URL is set.
# Experiment catalog is Postgres when DATABASE_URL is set, otherwise SQLite.
# There is no DynamoDB experiment catalog.
#
# Step 5 — experiment parquet lake (Go jobs; frontend helpers for docs):
# LAKE_BACKEND=fs        # fs | s3
# LAKE_DUAL_WRITE=0      # 1 to dual-write parquet to S3 while LAKE_BACKEND=fs
#
# Step 6 — experiment fan-out (default: single docker container, EXPERIMENT_RUN_BACKEND=docker):
# EXPERIMENT_RUN_BACKEND=docker   # docker | batched | sfn
# EXPERIMENT_BATCH_SIZE=64
# EXPERIMENT_MAP_MAX_CONCURRENCY=8   # raise to ~200 on AWS
# EXPERIMENT_SFN_ARN=                  # terraform output experiment_sfn_arn; sfn falls back to batched if unset
# EXPERIMENT_RUN_HEAVY=0               # 1 = monolithic docker RunExperiment (long-tail / future Fargate Spot)
#
# Steps 7–8 — Postgres control plane (Compose; Atlas migrations in db/):
# POSTGRES_USER=trading
# POSTGRES_PASSWORD=trading
# POSTGRES_DB=trading
# Host tools (task db:migrate) use POSTGRES_PORT when DATABASE_URL is unset.
# DATABASE_URL=postgres://trading:trading@127.0.0.1:5432/trading?sslmode=disable&search_path=public
# Inside Compose services use host postgres: …@postgres:5432/…
# Apply: task db:migrate
# Go Experiment API (orchestrator :8090 or standalone experiment-api :8091):
# EXPERIMENT_API_URL=http://127.0.0.1:8090
# The Vite dev server forwards /api/* to the orchestrator (VITE_DEV_API_PROXY).
# Diff after HCL edits: task db:diff name=my_change
# Supabase (later): SUPABASE_DB_URL=postgres://…:5432/postgres?sslmode=require&search_path=public
